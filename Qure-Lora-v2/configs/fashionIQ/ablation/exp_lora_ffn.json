{
  "epoch": 30,
  "negative_definition_epoch_num": 6,
  "model": "blip2",
  "backbone": "pretrain_vitL",
  "batch_size": 8,
  "rerank_batch_size": 16,
  "rerank_gallery_chunk_size": 1024,
  "num_workers": 4,
  "img_size": 224,
  "blip_size": "base",
  "text_encoder": "blip",
  "weight_decay": 0.05,
  "random_seed": 1000,
  "experiment_dir": "runs",
  "init_lr": 5e-06,
  "lora_lr": 1e-04,
  "warmup_steps": 500,
  "min_lr": 5e-08,
  "dataset": "fashionIQ",
  "wandb_project_name": "QuRe",
  "wandb_account_name": "-",
  "device_idx": "0",
  "experiment_description": "exp_lora_ffn",
  "mode": "train",
  "negative": "random_rerank",
  "use_temp": true,
  "use_rerank": true,
  "consecutive_threshold": 1,
  "percentage_threshold": 5,
  "rerank_warmup": true,
  "init_topk": 100,
  "fashioniq_root": "../fashing_iq",
  "use_lora": true,
  "use_amp": true,
  "use_wandb": false,
  "eval_frequency": 1,
  "lora_mode": "separate",
  "lora_lambda": 1.0,
  "target_scope": "both",
  "lora": {
    "rank": 8,
    "alpha": 16,
    "dropout": 0.05,
    "target_modules": [
      "attention.self.query",
      "attention.self.value",
      "crossattention.self.query",
      "crossattention.self.value",
      "encoder.layer.*.intermediate.dense",
      "encoder.layer.*.output.dense",
      "encoder.layer.*.intermediate_query.dense",
      "encoder.layer.*.output_query.dense"
    ]
  }
}
